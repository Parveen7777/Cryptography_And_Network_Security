#include <iostream>
#include <string>
#include <cctype>
using namespace std;

int main() {
    string password;
    bool upper = false, lower = false, digit = false;

    cout << "Enter Password: ";
    cin >> password;

    if (password.length() >= 8) {
        for (char ch : password) {
            if (isupper(ch))
                upper = true;
            else if (islower(ch))
                lower = true;
            else if (isdigit(ch))
                digit = true;
        }

        if (upper && lower && digit)
            cout << "Password is Strong." << endl;
        else
            cout << "Password is Weak." << endl;
    } else {
        cout << "Password is Weak." << endl;
    }

    return 0;
}
