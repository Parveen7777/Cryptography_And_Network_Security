#include <iostream>
#include <fstream>
#include <string>
using namespace std;

// XOR Encryption/Decryption
string encryptDecrypt(string text, char key) {
    for (int i = 0; i < text.length(); i++)
        text[i] = text[i] ^ key;
    return text;
}

// Hide Encrypted Message
void hideMessage() {
    string inputImage, outputImage, message;

    cout << "Enter Input BMP Image: ";
    cin >> inputImage;

    cout << "Enter Output BMP Image: ";
    cin >> outputImage;

    cin.ignore();
    cout << "Enter Secret Message: ";
    getline(cin, message);

    char key = 'K';
    message = encryptDecrypt(message, key);
    message += '\0';

    ifstream in(inputImage, ios::binary);
    ofstream out(outputImage, ios::binary);

    if (!in || !out) {
        cout << "File Error!";
        return;
    }

    char ch;

    // Copy BMP Header (54 bytes)
    for (int i = 0; i < 54; i++) {
        in.get(ch);
        out.put(ch);
    }

    // Hide encrypted message using LSB
    for (char c : message) {
        for (int i = 7; i >= 0; i--) {
            in.get(ch);
            ch = (ch & 0xFE) | ((c >> i) & 1);
            out.put(ch);
        }
    }

    while (in.get(ch))
        out.put(ch);

    in.close();
    out.close();

    cout << "Encrypted Message Hidden Successfully!";
}

// Extract and Decrypt Message
void extractMessage() {
    string imageFile;

    cout << "Enter BMP Image: ";
    cin >> imageFile;

    ifstream in(imageFile, ios::binary);

    if (!in) {
        cout << "File Error!";
        return;
    }

    in.seekg(54);

    string encrypted = "";
    char ch;

    while (true) {
        char c = 0;

        for (int i = 7; i >= 0; i--) {
            in.get(ch);
            c |= (ch & 1) << i;
        }

        if (c == '\0')
            break;

        encrypted += c;
    }

    in.close();

    char key = 'K';
    string message = encryptDecrypt(encrypted, key);

    cout << "Decrypted Message: " << message;
}

int main() {
    int choice;

    cout << "1. Hide Message\n";
    cout << "2. Extract Message\n";
    cout << "Enter Choice: ";
    cin >> choice;

    if (choice == 1)
        hideMessage();
    else if (choice == 2)
        extractMessage();
    else
        cout << "Invalid Choice!";

    return 0;
}
