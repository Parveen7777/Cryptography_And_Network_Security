// Hide message with password
void hideMessage() {
    string inputImage, outputImage, password, message, data;

    cout << "Enter Input Image: ";
    cin >> inputImage;

    cout << "Enter Output Image: ";
    cin >> outputImage;

    cin.ignore();
    cout << "Enter Password: ";
    getline(cin, password);

    cout << "Enter Secret Message: ";
    getline(cin, message);

    data = password + "|" + message + '\0';

    ifstream in(inputImage, ios::binary);
    ofstream out(outputImage, ios::binary);

    if (!in || !out) {
        cout << "File Error!";
        return;
    }

    char ch;

    // Copy BMP header
    for (int i = 0; i < 54; i++) {
        in.get(ch);
        out.put(ch);
    }

    // Hide data using LSB
    for (char c : data) {
        for (int i = 7; i >= 0; i--) {
            in.get(ch);
            ch = (ch & 0xFE) | ((c >> i) & 1);
            out.put(ch);
        }
    }

    while (in.get(ch))
        out.put(ch);

    in.close();
    out.close();

    cout << "Message Hidden Successfully!";
}

// Extract message
void extractMessage() {
    string imageFile, enteredPassword, extracted = "";

    cout << "Enter Image File: ";
    cin >> imageFile;

    ifstream in(imageFile, ios::binary);

    if (!in) {
        cout << "File Error!";
        return;
    }

    in.seekg(54);

    char ch;

    while (true) {
        char c = 0;

        for (int i = 7; i >= 0; i--) {
            in.get(ch);
            c |= (ch & 1) << i;
        }

        if (c == '\0')
            break;

        extracted += c;
    }

    in.close();

    int pos = extracted.find('|');

    string savedPassword = extracted.substr(0, pos);
    string message = extracted.substr(pos + 1);

    cout << "Enter Password: ";
    cin >> enteredPassword;

    if (enteredPassword == savedPassword)
        cout << "Hidden Message: " << message;
    else
        cout << "Wrong Password! Access Denied.";
}

