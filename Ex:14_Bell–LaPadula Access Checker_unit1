#include <iostream>
#include <string>
using namespace std;

int getLevel(string level) {
    if (level == "Public") return 1;
    if (level == "Confidential") return 2;
    if (level == "Secret") return 3;
    if (level == "TopSecret") return 4;
    return 0;
}

int main() {
    string userLevel, fileLevel, operation;

    cout << "User Level (Public/Confidential/Secret/TopSecret): ";
    cin >> userLevel;

    cout << "File Level (Public/Confidential/Secret/TopSecret): ";
    cin >> fileLevel;

    cout << "Operation (Read/Write): ";
    cin >> operation;

    int user = getLevel(userLevel);
    int file = getLevel(fileLevel);

    if (user == 0 || file == 0) {
        cout << "Invalid Security Level";
    }
    else if (operation == "Read" || operation == "read") {
        if (user >= file)
            cout << "Access Allowed";
        else
            cout << "Access Denied";
    }
    else if (operation == "Write" || operation == "write") {
        if (user <= file)
            cout << "Access Allowed";
        else
            cout << "Access Denied";
    }
    else {
        cout << "Invalid Operation";
    }

    return 0;
}
