// Hide message
void hideMessage() {
    string imageFile, outputFile, message;

    cout << "Enter Input Image File: ";
    cin >> imageFile;

    cout << "Enter Output Image File: ";
    cin >> outputFile;

    cin.ignore();
    cout << "Enter Secret Message: ";
    getline(cin, message);

    ifstream in(imageFile, ios::binary);
    ofstream out(outputFile, ios::binary);

    if (!in || !out) {
        cout << "File Error!";
        return;
    }

    char ch;

    // Copy BMP header (54 bytes)
    for (int i = 0; i < 54; i++) {
        in.get(ch);
        out.put(ch);
    }

    message += '\0'; // End of message

    for (char c : message) {
        for (int i = 7; i >= 0; i--) {
            in.get(ch);
            ch = (ch & 0xFE) | ((c >> i) & 1);
            out.put(ch);
        }
    }

    while (in.get(ch))
        out.put(ch);

    in.close();
    out.close();

    cout << "Message Hidden Successfully!";
}

// Extract message
void extractMessage() {
    string imageFile;
    cout << "Enter Image File: ";
    cin >> imageFile;

    ifstream in(imageFile, ios::binary);

    if (!in) {
        cout << "File Error!";
        return;
    }

    char ch;

    // Skip BMP header
    in.seekg(54);

    cout << "Hidden Message: ";

    while (true) {
        char c = 0;

        for (int i = 7; i >= 0; i--) {
            in.get(ch);
            c |= (ch & 1) << i;
        }

        if (c == '\0')
            break;

        cout << c;
    }

    in.close();
}

int main() {
    int choice;

    cout << "1. Hide Message\n";
    cout << "2. Extract Message\n";
    cout << "Enter Choice: ";
    cin >> choice;

    if (choice == 1)
        hideMessage();
    else if (choice == 2)
        extractMessage();
    else
        cout << "Invalid Choice!";

    return 0;
}
