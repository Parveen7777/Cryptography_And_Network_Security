#include <iostream>
using namespace std;

int main() {
    int likelihood, impact, risk;

    cout << "Likelihood (1-5): ";
    cin >> likelihood;

    cout << "Impact (1-5): ";
    cin >> impact;

    risk = likelihood * impact;

    cout << "Risk Score: " << risk << endl;

    if (risk <= 5)
        cout << "Risk Level: Low";
    else if (risk <= 15)
        cout << "Risk Level: Medium";
    else
        cout << "Risk Level: High";

    return 0;
}
