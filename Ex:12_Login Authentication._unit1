#include <iostream>
#include <string>
using namespace std;

int main() {
    string username, password;

    string correctUsername = "admin";
    string correctPassword = "admin123";

    cout << "Username: ";
    cin >> username;

    cout << "Password: ";
    cin >> password;

    if (username == correctUsername && password == correctPassword)
        cout << "Login Successful";
    else
        cout << "Invalid Username or Password";

    return 0;
}
